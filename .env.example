# Copie para .env (produção) ou .env.local (dev).
# Senha com # @ : / precisa ir codificada: %23 %40 %3A %2F
DATABASE_URL="mysql://usuario:senha@localhost:3306/konstancy"

# Assina o cookie de sessão (32+ bytes aleatórios).
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSAO_SEGREDO=""

# Web Push — gere com: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTATO="mailto:voce@exemplo.com"

# Pasta das fotos. Em produção, fora da pasta do app, para não sumir a cada deploy.
STORAGE_DIR="./uploads"

# Protege /api/cron (lembrete diário e encerramento de desafios).
CRON_SEGREDO=""

# E-mail (códigos de confirmação e de recuperação de senha). A conta de e-mail
# do domínio na Hostinger serve: smtp.hostinger.com, porta 465.
# Sem SMTP_HOST, em desenvolvimento o código aparece no terminal do `next dev`.
SMTP_HOST=""
SMTP_PORTA="465"
SMTP_USUARIO=""
SMTP_SENHA=""
EMAIL_REMETENTE="Konstancy <nao-responda@seudominio.com.br>"
