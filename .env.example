# Copie para .env.local (desenvolvimento). Em produção, as variáveis ficam no
# painel da Vercel (Settings → Environment Variables).

# Banco PostgreSQL. Local: `npm run db:local` sobe um Postgres (prisma dev) e
# imprime a URL. Na Vercel, a integração do Neon cria DATABASE_URL (com pool,
# usada pelo app) e DATABASE_URL_UNPOOLED (direta, usada pelas migrations).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/konstancy?sslmode=disable"
# DATABASE_URL_UNPOOLED=""

# Assina o cookie de sessão (32+ bytes aleatórios).
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSAO_SEGREDO=""

# Web Push — gere com: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTATO="mailto:voce@exemplo.com"

# Fotos. Sem S3_BUCKET, ficam na pasta STORAGE_DIR (só desenvolvimento — na
# Vercel não há disco permanente). Em produção: Cloudflare R2 (ou outro S3).
STORAGE_DIR="./uploads"
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="konstancy-fotos"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_REGION="auto"

# Protege /api/cron/* — a Vercel envia "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# E-mail dos códigos (confirmação e recuperação de senha). Gmail: ative a
# verificação em duas etapas e crie uma "senha de app". Sem SMTP_HOST, em
# desenvolvimento o código aparece no terminal do `next dev`.
SMTP_HOST=""
SMTP_PORTA="465"
SMTP_USUARIO=""
SMTP_SENHA=""
EMAIL_REMETENTE="Konstancy <seuemail@gmail.com>"
